<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme — Compose handles all theming at runtime.
         This theme provides a splash/startup appearance before Compose loads. -->
    <style name="Theme.ZVault" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
